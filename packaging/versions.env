# Source locks for the Rerinku minimal FFmpeg build.
#
# FFmpeg current stable was verified from https://ffmpeg.org/download.html on
# 2026-09-04: 9.0.1 "Lei", released 2026-08-12.
FFMPEG_VERSION=9.0.1
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-9.0.1.tar.xz
FFMPEG_SHA256=cf38e0e28c7e5605942c4a77755349b0145804a397af37eb1fb4c77cb237f635

# x264 does not publish versioned release tarballs in the same shape as FFmpeg.
# Pin the VideoLAN stable branch to a commit and archive/clone that exact tree.
X264_REPO=https://code.videolan.org/videolan/x264.git
X264_REF=b35605ace3ddf7c1a5d67a2eb553f034aef41d55

X265_REPO=https://github.com/Multicorewareinc/x265.git
X265_REF=e9b88125dc21393b3fd8d68e98083bdfb89778a8

OPUS_VERSION=1.6.1
OPUS_URL=https://downloads.xiph.org/releases/opus/opus-1.6.1.tar.gz
OPUS_SHA256=6ffcb593207be92584df15b32466ed64bbec99109f007c82205f0194572411a1

LIBWEBP_VERSION=1.6.0
LIBWEBP_URL=https://storage.googleapis.com/downloads.webmproject.org/releases/webp/libwebp-1.6.0.tar.gz
LIBWEBP_SHA256=e4ab7009bf0629fd11982d4c2aa83964cf244cffba7347ecd39019a9e38c4564

# alsa-lib is only needed when WITH_ALSA=1 (ALSA capture for UVC USB
# microphones, see rerinku-cli/internal/uvc/audio_linux.go). Neither Debian nor
# Alpine ship a static libasound.a, so it is built from source here.
ALSA_LIB_VERSION=1.2.15
ALSA_LIB_URL=https://www.alsa-project.org/files/pub/lib/alsa-lib-1.2.15.tar.bz2
ALSA_LIB_SHA256=83770841585e766a60c99fd23f8c574c22643ae0cb1f2d20b793c3d84eb95a8d

# Hardware decoding on Linux (VA-API, NVDEC). libva and libdrm are linked
# statically; the VA drivers (radeonsi, iHD, i965) and NVIDIA's
# libcuda/libnvcuvid are the system's, loaded at run time — which is why the
# Linux executable links glibc dynamically. Release builds come from the old-
# glibc container of scripts/build-linux-amd64-container.sh.
LIBVA_VERSION=2.24.1
LIBVA_URL=https://github.com/intel/libva/releases/download/2.24.1/libva-2.24.1.tar.bz2
LIBVA_SHA256=eec6050b52876f229bd35e9df17cd31a06785e18e6f7990c445b584628483d67

LIBDRM_VERSION=2.4.134
LIBDRM_URL=https://dri.freedesktop.org/libdrm/libdrm-2.4.134.tar.xz
LIBDRM_SHA256=ac5e74d157830eb8bee44c6a6bf3ad49774ef0dd2a72bdad74a8f20308b52a95

# The oldest NVDEC API FFmpeg 9 accepts (11.1): it runs on NVIDIA drivers from
# 470.57 on, where the newer headers would require 520+ or 570+.
NV_CODEC_HEADERS_VERSION=11.1.5.3
NV_CODEC_HEADERS_URL=https://github.com/FFmpeg/nv-codec-headers/releases/download/n11.1.5.3/nv-codec-headers-11.1.5.3.tar.gz
NV_CODEC_HEADERS_SHA256=2974b91062197e0527dffa3aadd8fe3bfa6681ae45f5ff9181bc0ca6479abd59

# libdrm only builds with meson; run from its release tarball (pure Python),
# so no system package or virtualenv is needed. 1.9 is the newest meson that
# still runs on Debian 11's Python 3.9 (the release build's container).
MESON_VERSION=1.9.1
MESON_URL=https://github.com/mesonbuild/meson/releases/download/1.9.1/meson-1.9.1.tar.gz
MESON_SHA256=4e076606f2afff7881d195574bddcd8d89286f35a17b4977a216f535dc0c74ac
